{
  "name": "qrate",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @qrate/server dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "e2e": "pnpm -r --workspace-concurrency=1 e2e",
    "blog:new": "pnpm --filter @qrate/blog-tools run new",
    "blog:publish": "pnpm --filter @qrate/blog-tools run post"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild"
    ]
  }
}
