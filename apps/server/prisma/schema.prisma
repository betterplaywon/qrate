// 개발 DB 결정(2026-11-02): W1에서 스키마만 확정, W3 첫날에 Postgres(compose) + Prisma로 연결했다.
// 스키마 변경은 `prisma migrate dev --name <설명>`으로 마이그레이션 파일(prisma/migrations/)을 남긴다.
// 마이그레이션을 시작한 뒤에는 개발 DB에 db push를 쓰지 않고, 브랜치 안의 자잘한 마이그레이션은 머지 전 하나로 정리한다.
//
// 서버는 저장소 계약(src/repo/types.ts)만 본다. 구현은 둘 — 메모리(src/repo/memory.ts, 테스트·DB 없는 로컬)와
// Prisma(src/repo/prisma.ts, DATABASE_URL이 있을 때). 두 구현에 같은 계약 테스트(test/repo-contract.ts)를 돌린다.
// DB 주소는 prisma.config.ts(CLI)와 src/config.ts(서버)가 각각 DATABASE_URL에서 읽는다.

generator client {
  // Prisma 7: TypeScript 소스를 생성한다(src/generated/prisma, git·lint 제외). tsc가 dist로 함께 컴파일한다.
  // import 확장자는 .js — NodeNext(tsc)·tsx·vitest 모두 .js → .ts 해석을 한다.
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String          @id @default(cuid())
  name           String
  // 위젯 설치 스니펫의 data-tenant 키. 노출되는 식별자이므로 비밀키가 아니다.
  // 어느 사이트에서 쓸 수 있는지는 테넌트 검증(Origin 검사 src/origin.ts + GET /frame의 frame-ancestors src/http/frame.ts)이 막는다.
  apiKey         String          @unique
  // 위젯을 넣을 수 있는 사이트의 정규형 오리진(scheme://host[:port]). CSP 헤더에 그대로 들어가므로 쓰기 전에 isOriginString으로 검증한다.
  allowedOrigins String[]
  // 운영 콘솔 로그인 키의 해시(scrypt, src/console/key.ts). 원문은 저장하지 않는다 — 시드는 QRATE_DEMO_CONSOLE_KEY를 해시해 넣는다.
  // null이면 이 테넌트는 콘솔에 로그인할 수 없다. 콘솔 결정(2026-11-04): 인증 단위는 테넌트, 세션은 서명된 HttpOnly 쿠키.
  consoleKeyHash String?
  createdAt      DateTime        @default(now())
  conversations  Conversation[]
  knowledge      KnowledgeItem[]
  handoffs       Handoff[]
  credits        CreditLedger[]
  topUps         CreditTopUp[]
  events         Event[]
}

// 답변 근거(FAQ). 문단(blocks) 하나가 인용의 최소 단위다(ADR-0004).
// id는 시드의 'faq:plans' 같은 안정 식별자이고 테넌트 안에서만 유일하다 — 테넌트마다 같은 id 체계를 쓸 수 있게 복합 키.
// 프롬프트 캐시 접두사가 요청마다 같아야 하므로 조회 순서는 id 오름차순(코드 단위)으로 고정하는데,
// Postgres ORDER BY는 DB 콜레이션을 따라 구두점 처리가 다를 수 있어 정렬은 저장소 구현이 JS에서 한다(src/repo/prisma.ts).
model KnowledgeItem {
  id        String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  title     String
  category  String
  blocks    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenantId, id])
}

// 대화는 첫 턴이 저장될 때 생긴다(저장소 계약 appendTurn). id는 서비스가 미리 만든 UUID(chat/service.ts).
model Conversation {
  id        String    @id
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]
  handoffs  Handoff[]

  // 콘솔의 대화 목록은 "테넌트별 최근순" 조회 → 복합 인덱스.
  @@index([tenantId, createdAt])
}

enum MessageRole {
  user
  assistant
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  // 대화 안의 순서. 질문·답변이 한 트랜잭션에 들어가면 createdAt이 같을 수 있어 시각으로는 순서를 못 정한다 —
  // 전역 시퀀스가 저장 순서를 그대로 고정한다(메모리 구현의 배열 순서와 같은 뜻). 조회는 항상 이 열로 정렬한다.
  seq            Int          @default(autoincrement())
  role           MessageRole
  content        String
  // 질문은 받은 시각, 답변은 저장 시각(저장소 계약 NewTurn).
  createdAt      DateTime     @default(now())

  // 대화 화면은 항상 "대화별 순서대로" 조회 → 복합 인덱스. (왜 단일 인덱스 2개가 아닌가 — 면접 소재)
  @@index([conversationId, seq])
}

// 상담원 연결 요청 = 미응답 큐의 항목(콘솔 결정 2026-11-04: 큐에는 이 행만 들어간다).
// 두 입구 — 모델의 신호(engine/handoff.ts의 request_handoff 도구 → event: handoff, source=model)와
// 방문자의 "상담원 연결" 버튼(POST /api/handoff, source=visitor, contact에 연락처). 운영자가 콘솔에서 상태를 옮긴다.
enum HandoffReason {
  not_in_knowledge
  needs_human
  out_of_scope
  other
}

enum HandoffSource {
  model
  visitor
}

enum HandoffStatus {
  open
  in_progress
  done
}

model Handoff {
  id             String        @id @default(cuid())
  // 큐 조회("테넌트의 열린 요청")를 위한 비정규화. 대화의 tenantId와 항상 같다 — 같은 트랜잭션에서 대화를 확인하고 넣는다.
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  source         HandoffSource @default(model)
  reason         HandoffReason
  // 모델 신호면 질문 요약, 방문자 요청이면 방문자가 적은 메모.
  summary        String?
  // 방문자 요청의 연락처(이메일). 답은 밖(이메일 등)에서 하고 콘솔은 상태만 옮긴다.
  contact        String?
  status         HandoffStatus @default(open)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([conversationId, createdAt])
}

// 크레딧 원장(W4 결정 2026-11-05). 잔액은 이 표의 delta 합계다 — 캐시 열은 두지 않는다(필요가 보이면 W6 부하 때).
// (tenantId, idempotencyKey)의 UNIQUE 제약이 멱등 처리의 핵심: 같은 충전·차감 요청이 네트워크 재시도로 두 번 도착해도
// 두 번째 INSERT는 제약 위반(또는 skipDuplicates)으로 들어가지 않아 잔액이 두 번 움직일 수 없다.
// 키의 범위를 테넌트로 둔 이유: 충전 요청 키는 클라이언트(콘솔)가 만들어 다른 테넌트가 같은 값을 보낼 수 있다.
// 키의 출처는 둘이고 접두사로 구분한다 — `seed:` 초기 지급, `turn:<턴 id>` 답변 차감, `topup:<주문 id>` 충전(제공자 승인), 그 밖 `adj:`.
enum CreditReason {
  seed
  topup
  turn
  adjustment
}

model CreditLedger {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  delta          Int // 충전 +, 차감 -
  reason         CreditReason
  idempotencyKey String
  createdAt      DateTime     @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
}

// 충전 주문과 결제 제공자 이벤트(W4). 원장이 한 번만 움직이게 하는 제약은 넷이다 — 주문 (tenantId, requestKey) UNIQUE(콘솔 재시도),
// 이벤트 (provider, eventId) PK(재배달), 주문 상태의 조건부 UPDATE(순서 뒤바뀜, src/billing/settlement.ts), 원장 topup:<주문 id> 키(마지막 방어선).
enum TopUpStatus {
  pending
  failed
  paid
}

enum PaymentProviderName {
  mock
  toss
}

enum PaymentResult {
  paid
  failed
}

enum SettleOutcome {
  applied
  stale
}

model CreditTopUp {
  id         String              @id @default(cuid())
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  requestKey String
  packageId  String
  credits    Int
  amount     Int // 원(KRW)
  provider   PaymentProviderName
  status     TopUpStatus         @default(pending)
  settledAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  events     PaymentEvent[]

  @@unique([tenantId, requestKey])
  @@index([tenantId, createdAt])
}

model PaymentEvent {
  provider   PaymentProviderName
  eventId    String
  topUpId    String
  topUp      CreditTopUp         @relation(fields: [topUpId], references: [id])
  result     PaymentResult
  outcome    SettleOutcome
  receivedAt DateTime            @default(now())

  @@id([provider, eventId])
}

// 이벤트 로그(W4 ③). DB의 다른 표가 모르는 사실(시간·실패·거절·위젯 행동)만 쓴다 — 핸드오프·결제·크레딧은 각 표가 주인이다.
// 종류의 등록표는 코드(src/repo/types.ts의 AppEvent)다. enum이 아닌 이유: 새 종류를 쓴 뒤 코드를 되돌리면
// 옛 Prisma 클라이언트가 모르는 enum 값을 읽다 던진다. 로그는 앞뒤 버전 모두 읽을 수 있어야 한다.
model Event {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  type           String
  // FK가 없다 — 실패·중단 턴의 대화는 저장되지 않는다(chat/service.ts).
  conversationId String?
  // A/B 변형 키(W4 ④).
  variant        String?
  // chat_request만. 집계 대상이라 JSON이 아니라 열로 꺼냈다 — 캐스팅·원시 SQL 없이 고르고 정렬한다.
  ttftMs         Int?
  payload        Json
  // 사건이 일어난 시각(chat_request는 요청을 받은 시각). 쓰는 시각이 아니다.
  createdAt      DateTime @default(now())

  @@index([tenantId, type, createdAt])
}
