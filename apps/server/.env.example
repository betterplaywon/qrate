# 실제 값은 .env에 두고 커밋하지 않는다 (.gitignore 참고)
PORT=8787
DATABASE_URL=postgresql://qrate:qrate@localhost:5432/qrate
# Sentry 프로젝트 생성 후 DSN을 넣으면 자동 활성화. 비워두면 비활성.
SENTRY_DSN=

# Anthropic API 키. 비워두면 목업 엔진으로 동작한다 (CI·테스트는 키 없이 돈다).
ANTHROPIC_API_KEY=
# 답변 모델과 사고(thinking) 설정. 기본값은 Sonnet 5.5 + 사고 끔 (2026-11-02 결정, TTFT 우선).
#   QRATE_THINKING: off | low | medium | high   — off는 모델 계열별로 알맞은 표현으로 바뀐다 (src/engine/thinking.ts)
#   QRATE_FALLBACK: default | off               — 정책 거절 시 서버 측 대체 모델 재시도(베타)
QRATE_MODEL=claude-sonnet-5-5
QRATE_THINKING=off
QRATE_FALLBACK=default
# QRATE_ENGINE=auto        # auto | mock | claude
# QRATE_MAX_TOKENS=1024    # 사고를 켜면 기본 4096
