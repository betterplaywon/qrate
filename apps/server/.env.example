# 실제 값은 .env에 두고 커밋하지 않는다 (.gitignore 참고)
PORT=8787
# 연결을 받을 주소. 비우면 pnpm dev(NODE_ENV=development)는 127.0.0.1(이 컴퓨터만), 그 밖은 모든 인터페이스(컨테이너는 비워 둔다).
# QRATE_HOST=0.0.0.0
# 브라우저에 보이는 이 서버의 오리진(scheme://host[:port]). 대화 API는 이 오리진의 iframe 문서에서 온 요청만 받는다.
# 비워두면 http://localhost:PORT. 운영에서는 위젯 서버의 공개 주소(예: https://widget.example.com).
QRATE_PUBLIC_ORIGIN=
# Postgres(docker compose up -d db). 있으면 Prisma 저장소, 비우면 메모리 저장소(시드 파일) — QRATE_REPO=auto 기준.
# 스키마 반영은 pnpm --filter @qrate/server db:migrate(마이그레이션 파일 생성·적용), 데모 데이터는 db:seed.
DATABASE_URL=postgresql://qrate:qrate@localhost:5432/qrate
# QRATE_REPO=auto          # auto | memory | postgres
# 저장소 계약 테스트용 전용 DB(compose가 qrate_test를 함께 만든다). 설정하면 pnpm test가 Postgres 구현도 검사한다.
# 먼저 DATABASE_URL=postgresql://qrate:qrate@localhost:5432/qrate_test pnpm --filter @qrate/server db:deploy 로 마이그레이션을 적용한다.
# QRATE_TEST_DATABASE_URL=postgresql://qrate:qrate@localhost:5432/qrate_test
# 운영 콘솔(/console). 로그인 = 테넌트 키(demo) + 아래 콘솔 키. 시드 파일에는 비밀이 없어 이 값을 해시해 넣는다 —
#   메모리 저장소: 서버 시작 때. Postgres: pnpm --filter @qrate/server db:seed 때(바꾸면 다시 돌린다).
QRATE_DEMO_CONSOLE_KEY=
# 콘솔 세션 쿠키의 서명 비밀(16자 이상). 비우면 프로세스마다 무작위 → 서버를 재시작하면 다시 로그인.
QRATE_CONSOLE_SECRET=
# 크레딧 충전의 결제 제공자: auto | mock | toss | none. auto는 NODE_ENV가 development·test일 때만 mock(결제 없이 충전하는 테스트 버튼), 비어 있거나 그 밖이면 none. pnpm dev는 NODE_ENV=development로 뜬다.
# toss는 적을 때만 켜진다(토스페이먼츠 테스트 결제 — README '토스페이먼츠 테스트 결제').
# QRATE_PAYMENT_PROVIDER=auto
# 모의 제공자의 웹훅 서명 비밀(16자 이상). 비우면 프로세스마다 무작위 — 서명하는 쪽(결제 시뮬레이션)과 받는 쪽이 같은 서버라 동작한다.
QRATE_MOCK_PAYMENT_SECRET=
# 토스페이먼츠 결제창형 테스트 키 두 개(QRATE_PAYMENT_PROVIDER=toss일 때 둘 다 필요). test_gck_·test_gsk_만 받는다 — 라이브 키·API 개별 연동 키면 서버가 뜨지 않는다.
# 클라이언트 키는 브라우저용 공개 값이고, 시크릿 키는 서버만 쓴다(로그·응답에 남지 않는다).
QRATE_TOSS_CLIENT_KEY=
QRATE_TOSS_SECRET_KEY=
# Sentry 프로젝트 생성 후 DSN을 넣으면 자동 활성화. 비워두면 비활성.
SENTRY_DSN=

# Anthropic API 키. 비워두면 목업 엔진으로 동작한다 (CI·테스트는 키 없이 돈다).
ANTHROPIC_API_KEY=
# 답변 모델과 사고(thinking) 설정. 기본값은 Sonnet 5.5 + 사고 끔 (2026-11-02 결정, TTFT 우선).
#   QRATE_THINKING: off | low | medium | high   — off는 모델 계열별로 알맞은 표현으로 바뀐다 (src/engine/thinking.ts)
#   QRATE_FALLBACK: default | off               — 정책 거절 시 서버 측 대체 모델 재시도(베타)
QRATE_MODEL=claude-sonnet-5-5
QRATE_THINKING=off
QRATE_FALLBACK=default
# QRATE_ENGINE=auto        # auto | mock | claude
# QRATE_MAX_TOKENS=1024    # 사고를 켜면 기본 4096
