{
  "name": "@qrate/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --conditions=source --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx --conditions=source eval/run.ts",
    "eval:paid": "tsx --conditions=source --env-file=.env eval/run.ts",
    "eval:faq-size": "tsx --conditions=source eval/faq-size.ts",
    "eval:faq-size:paid": "tsx --conditions=source --env-file=.env eval/faq-size.ts --paid",
    "load": "tsx --conditions=source load/ladder.ts",
    "admin": "tsx --conditions=source --env-file-if-exists=.env src/admin/cli.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "files": [
    "dist",
    "seed"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@qrate/console": "workspace:*",
    "@qrate/contracts": "workspace:*",
    "@qrate/widget": "workspace:*",
    "@sentry/node": "^10.0.0",
    "cookie": "2.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.3",
    "jose": "6.2.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prisma": "7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
